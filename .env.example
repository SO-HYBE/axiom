# AXIOM configuration example.
#
# Copy this file to `.env` only if you want live model answers. The dashboard,
# corpus search, the Mission Scenario Stress Test, the Next Experiment Planner
# and the saved demonstrations work with no keys at all.
#
# Never commit `.env`. The parser accepts `KEY=value` and optional quotes.

# ---------------------------------------------------------------------------
# Model provider credentials (optional)
# ---------------------------------------------------------------------------
# Groq is the default live provider. Create a key at https://console.groq.com/
GROQ_KEY=

# OpenRouter is the alternative hosted provider. Create a key at
# https://openrouter.ai/keys
OPENROUTER_KEY=

# Optional fixed model identifiers. Leave blank to use the provider default.
GROQ_MODEL=
OPENROUTER_MODEL=

# Local extraction-only provider needs no key (provider name: extractive).
# A local Ollama install is also supported (provider name: ollama); it uses its
# own default host and is never contacted at startup.

# ---------------------------------------------------------------------------
# HTTP service configuration
# ---------------------------------------------------------------------------
# Bind address. Use 127.0.0.1 for a workstation. Containers need 0.0.0.0.
AXIOM_HOST=127.0.0.1

# TCP port for the dashboard.
AXIOM_PORT=8765

# Public host names the service answers for, comma-separated. Loopback names
# are always accepted. Set this to the exact public host (including port when
# it is not 80/443) before exposing the service through a proxy or tunnel.
# Example: axiom.example.org,axiom.example.org:443
AXIOM_ALLOWED_HOSTS=

# Browser origins allowed to call the API from a separately hosted frontend,
# comma-separated. Leave empty for same-origin-only use. Exact match, including
# scheme; default ports and trailing slashes are normalised.
# Example: https://app.example.org,https://www.app.example.org
AXIOM_ALLOWED_ORIGINS=

# Set to 1 to write one access-log line per request to stderr.
AXIOM_LOG_REQUESTS=0
